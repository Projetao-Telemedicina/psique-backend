{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "maxWorkers": 1,
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["<rootDir>/setup-e2e-env.ts"],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.json"
      }
    ]
  },
  "moduleNameMapper": {
  "^@/(.*)$": "<rootDir>/../src/$1",
  "^(\\.{1,2}/.*)\\.js$": "$1"
}
}
