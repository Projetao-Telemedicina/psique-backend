generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PROFESSIONAL
  PATIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ProfessionalApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OnlineStatus {
  OFFLINE
  ONLINE
}

enum EmergencyRequestStatus {
  SEARCHING
  OFFER_PENDING
  MATCHED
  EXPIRED
  CANCELLED
}

enum EmergencyOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ProfessionalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  SCHEDULED
  RESCHEDULE_REQUESTED
  CANCELED
  COMPLETED
  NO_SHOW
}

enum AppointmentCanceledBy {
  PATIENT
  PROFESSIONAL
  ADMIN
  SYSTEM
}

enum RescheduleRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

