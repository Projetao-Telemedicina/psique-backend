model Appointment {
  id                            String                 @id @default(uuid()) @map("appointment_id")
  emergencyRequestId            String?                @unique @map("emergency_request_id")
  patientId                     String                 @map("patient_id")
  professionalId                String                 @map("professional_id")
  status                        AppointmentStatus      @default(SCHEDULED)
  startsAt                      DateTime               @map("starts_at")
  endsAt                        DateTime               @map("ends_at")
  priceCents                    Int                    @map("price_cents")
  confirmedAt                   DateTime?              @map("confirmed_at")
  canceledBy                    AppointmentCanceledBy? @map("canceled_by")
  cancellationReason            String?                @map("cancellation_reason")
  canceledAt                    DateTime?              @map("canceled_at")
  completedAt                   DateTime?              @map("completed_at")
  rescheduledFromAppointmentId  String?                @map("rescheduled_from_appointment_id")
  attendanceCertificateUrl      String?                @map("attendance_certificate_url")
  createdAt                     DateTime               @default(now()) @map("created_at")
  updatedAt                     DateTime               @updatedAt @map("updated_at")

  googleCalendarEventId  String?  @map("google_calendar_event_id")
  meetLink               String?  @map("meet_link")

  emergencyRequest EmergencyRequest? @relation(fields: [emergencyRequestId], references: [id], onDelete: SetNull)
  patient      PatientProfile       @relation(fields: [patientId], references: [userId])
  professional ProfessionalProfile  @relation(fields: [professionalId], references: [userId])

  rescheduledFrom Appointment?  @relation("AppointmentRescheduleChain", fields: [rescheduledFromAppointmentId], references: [id])
  rescheduledTo   Appointment[] @relation("AppointmentRescheduleChain")

  rescheduleRequests AppointmentRescheduleRequest[]
  review             Review?
  // chatRooms          ChatRoom[]
  // walletTransactions WalletTransaction[]
  // payments           Payment[]
  // videoCallSessions  VideoCallSession[]

  @@map("appointments")
}

model AppointmentRescheduleRequest {
  id                    String   @id @default(uuid()) @map("request_id")
  appointmentId         String   @map("appointment_id")
  requestedBy           String   @map("requested_by")
  status                RescheduleRequestStatus @default(PENDING)
  suggestedStartsAt     DateTime @map("suggested_starts_at")
  suggestedEndsAt       DateTime @map("suggested_ends_at")
  patientConfirmed      Boolean? @map("patient_confirmed")
  professionalConfirmed Boolean? @map("professional_confirmed")
  expiresAt             DateTime? @map("expires_at")
  createdAt             DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  requester   User        @relation(fields: [requestedBy], references: [id])

  @@map("appointment_reschedule_requests")
}

model Review {
  id             String   @id @default(uuid()) @map("review_id")
  appointmentId  String   @unique @map("appointment_id")
  patientId      String   @map("patient_id")
  professionalId String   @map("professional_id")
  rating         Int
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at")

  appointment  Appointment         @relation(fields: [appointmentId], references: [id])
  patient      PatientProfile      @relation(fields: [patientId], references: [userId])
  professional ProfessionalProfile @relation(fields: [professionalId], references: [userId])

  @@map("reviews")
}

model EmergencyRequest {
  id                    String                 @id @default(uuid()) @map("emergency_request_id")
  patientId             String                 @map("patient_id")
  status                EmergencyRequestStatus @default(SEARCHING)
  matchedProfessionalId String?                @map("matched_professional_id")
  notes                 String?
  expiresAt             DateTime               @map("expires_at")
  matchedAt             DateTime?              @map("matched_at")
  cancelledAt           DateTime?              @map("cancelled_at")
  closedAt              DateTime?              @map("closed_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  patient             PatientProfile       @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  matchedProfessional ProfessionalProfile? @relation("EmergencyMatchedProfessional", fields: [matchedProfessionalId], references: [userId])
  appointment         Appointment?
  offers              EmergencyOffer[]

  @@index([patientId, status])
  @@index([status, createdAt])
  @@map("emergency_requests")
}

model EmergencyOffer {
  id                 String               @id @default(uuid()) @map("emergency_offer_id")
  emergencyRequestId String               @map("emergency_request_id")
  professionalId     String               @map("professional_id")
  status             EmergencyOfferStatus @default(PENDING)
  attemptNumber      Int                  @map("attempt_number")
  sentAt             DateTime             @default(now()) @map("sent_at")
  expiresAt          DateTime             @map("expires_at")
  respondedAt        DateTime?            @map("responded_at")
  rejectionReason    String?              @map("rejection_reason")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  emergencyRequest EmergencyRequest    @relation(fields: [emergencyRequestId], references: [id], onDelete: Cascade)
  professional     ProfessionalProfile @relation(fields: [professionalId], references: [userId])

  @@unique([emergencyRequestId, professionalId])
  @@index([emergencyRequestId, status])
  @@index([professionalId, status])
  @@index([status, expiresAt])
  @@map("emergency_offers")
}

