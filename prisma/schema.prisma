model User {
  id           String     @id @default(uuid()) @map("user_id")
  name         String
  cpf          String?    @unique
  email        String     @unique
  passwordHash String     @map("password_hash")
  birthDate    DateTime?  @db.Date @map("birth_date")
  gender       String?    @map("gender")
  role         Role
  status       UserStatus @default(INACTIVE)
  phone        String?
  bio          String?
  avatarUrl    String?    @map("avatar_url")

  cep          String?
  state        String?
  city         String?
  neighborhood String?
  street       String?
  number       String?
  complement   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patientProfile      PatientProfile?
  professionalProfile ProfessionalProfile?
  tokens              Token[]

  reviewedProfessionalRequests ProfessionalRequest[] @relation("ReviewedProfessionalRequests")
  requestedReschedules          AppointmentRescheduleRequest[]
  // sentMessages                  Message[]
  // paymentMethods                PaymentMethod[]
  // subscriptions                 Subscription[]
  // payments                      Payment[]
  // userCoupons                   UserCoupon[]
  // notifications                 Notification[]

  @@map("users")
}

model Token {
  id         String   @id @default(uuid()) @map("token_id")
  userId     String   @unique @map("user_id")
  jwt        String
  refreshJwt String   @map("refresh_jwt")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

model PatientProfile {
  userId                      String   @id @map("user_id")
  emergencyContactName        String?  @map("emergency_contact_name")
  emergencyContactPhone       String?  @map("emergency_contact_phone")
  shareDiaryWithProfessionals Boolean  @default(false) @map("share_diary_with_professionals")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  appointments   Appointment[]
  reviews        Review[]
  emergencyRequests EmergencyRequest[]
  // chatRooms      ChatRoom[]
  // wallet         Wallet?
  // panicRequests  PanicRequest[]
  diaryEntries   DiaryEntry[]

  @@map("patient_profiles")
}

model ProfessionalProfile {
  userId                        String                     @id @map("user_id")
  crp                           String                     @unique
  specialty                     String?
  approvalStatus                ProfessionalApprovalStatus @default(PENDING) @map("approval_status")
  onlineStatus                  OnlineStatus               @default(OFFLINE) @map("online_status")
  availableForEmergency         Boolean                    @default(false) @map("available_for_emergency")
  activeEmergencyOfferId        String?                    @unique @map("active_emergency_offer_id")
  autoAbsenceMessage            String?                    @map("auto_absence_message")
  gapBetweenAppointmentsMinutes Int                        @default(0) @map("gap_between_appointments_minutes")
  scoreAvg                      Decimal                    @default(0) @db.Decimal(4, 2) @map("score_avg")
  reviewCount                   Int                        @default(0) @map("review_count")
  createdAt                     DateTime                   @default(now()) @map("created_at")
  updatedAt                     DateTime                   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  requests        ProfessionalRequest[]
  // availabilities  ProfessionalAvailability[]
  // breaks          ProfessionalBreak[]
  // calendarEvents  ProfessionalCalendarEvent[]
  appointments    Appointment[]
  reviews         Review[]
  acceptedEmergencyRequests EmergencyRequest[] @relation("EmergencyMatchedProfessional")
  emergencyOffers EmergencyOffer[]
  // chatRooms       ChatRoom[]
  // promotions      ProfessionalPromotion[]
  // acceptedPanics  PanicRequest[]      @relation("AcceptedProfessional")
  // panicOffers     PanicRequestOffer[]

  @@map("professional_profiles")
}

model ProfessionalRequest {
  id              String        @id @default(uuid()) @map("request_id")
  professionalId  String        @map("professional_id")
  status          ProfessionalRequestStatus @default(PENDING)
  rejectionReason String?       @map("rejection_reason")
  reviewedBy      String?       @map("reviewed_by")
  submittedAt     DateTime      @default(now()) @map("submitted_at")
  reviewedAt      DateTime?     @map("reviewed_at")

  professional ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  reviewer     User?               @relation("ReviewedProfessionalRequests", fields: [reviewedBy], references: [id])

  documents ProfessionalRequestDocument[]

  @@map("professional_requests")
}

model ProfessionalRequestDocument {
  id               String   @id @default(uuid()) @map("document_id")
  requestId        String   @map("request_id")
  fileName         String   @map("file_name")
  mimeType         String   @map("mime_type")
  sizeBytes        Int      @map("size_bytes")
  fileData         Bytes    @map("file_data")
  documentType     String   @map("document_type")
  uploadedAt       DateTime @default(now()) @map("uploaded_at")

  request ProfessionalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("professional_request_documents")
}

